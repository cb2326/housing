{
  "name": "Open Housing Atlas",
  "short_name": "Housing Atlas",
  "description": "Free US housing data: home values, rents, forecasts, schools and risk for every state, metro, county and ZIP code.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf7f1",
  "theme_color": "#1e40af",
  "categories": ["finance", "lifestyle", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
